# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- IDENTIDAD DEL FABRICANTE DEL SIF (RD 1007/2023 & ORDEN HAC/1177/2024) ---
# ATENCIÓN: Los valores a continuación son plantillas reglamentarias. En despliegues
# productivos reales, DEBEN sustituirse por los datos reales del fabricante del software
# y la fecha/identificador efectivo de instalación antes de emitir registros a la AEAT.
# NIF oficial del desarrollador/fabricante del software de facturación (No ficticio ni de lista negra)
SIF_NIF="A12345674"
# Razón social del desarrollador/fabricante del software SIF
SIF_NOMBRE_RAZON="AGROTECH SISTEMAS INTEGRALES S.L."
# Identificador de la instalación del sistema informático
SIF_INSTALACION_ID="INST-PROD-01"
# Nombre comercial del sistema informático de facturación
SIF_NOMBRE_SIF="Gestión Avícola SIF"
# Versión del SIF (opcional, por defecto package.json version)
SIF_VERSION="1.0.0"
# Fecha de activación oficial del SIF (ISO 8601 UTC). Obligatoria en producción e inmutable tras primer despliegue
SIF_FECHA_ACTIVACION="2026-01-01T00:00:00Z"

# --- PROPIETARIO RAÍZ Y ADMINISTRACIÓN DEL SISTEMA ---
ROOT_OWNER_EMAIL="peduwan@gmail.com"

# --- CONFIGURACIÓN TRANSPORTE AEAT VERI*FACTU (ORDEN HAC/1177/2024) ---
# AEAT_ENV: 'test' (Entorno de pruebas/preproducción AEAT) o 'production' (Sede electrónica real AEAT)
# NOTA: 'mock' solo está permitido en desarrollo local (NODE_ENV !== 'production').
AEAT_ENV="test"
# AEAT_TRANSPORT_MODE: 'mock' (simulación 8 escenarios oficiales) o 'real' (SOAP mTLS real)
AEAT_TRANSPORT_MODE="real"
# AEAT_CERT_PFX_BASE64: Certificado cualificado X.509 en formato PKCS#12 (.p12/.pfx) en Base64 (Solo backend)
AEAT_CERT_PFX_BASE64=""
# AEAT_CERT_PASSPHRASE: Contraseña del archivo .pfx/.p12 (Solo backend, NUNCA frontend)
AEAT_CERT_PASSPHRASE=""
# AEAT_CERT_SUBJECT_NIF: NIF titular del certificado digital
AEAT_CERT_SUBJECT_NIF=""

